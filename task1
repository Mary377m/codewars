function hasTwoCubeSums(n) {
  let count = 0;
  const max = Math.floor(Math.cbrt(n));
  
  for (let a = 1; a <= max; a++) {
    for (let b = a + 1; b <= max; b++) {
      if (Math.pow(a, 3) + Math.pow(b, 3) === n) {
        count++;
        if (count === 2) {
          return true;
        }
      }
    }
  }
  
  return false;
}
