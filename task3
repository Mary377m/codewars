function whatCentury(year) {
  // Вычисляем номер века
  const century = Math.ceil(Number(year) / 100);
  
  // Исключения для 11, 12, 13 веков (они всегда заканчиваются на 'th')
  if (century >= 11 && century <= 13) {
    return century + 'th';
  }
  
  // Подбираем окончание в зависимости от последней цифры
  const lastDigit = century % 10;
  switch (lastDigit) {
    case 1:  return century + 'st';
    case 2:  return century + 'nd';
    case 3:  return century + 'rd';
    default: return century + 'th';
  }
}
